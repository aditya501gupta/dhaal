# DHAAL — copy to .env and fill. NEVER commit the real .env.
# L1 (day 2+): LLM reasoning + fallback
GROQ_API_KEY=
GEMINI_API_KEY=
# L2 Forensic Agent (day 3+): live URL threat intelligence. BOTH OPTIONAL —
# without them the Forensic Agent still runs on offline heuristics; with them it
# upgrades to authoritative feed verdicts.
#   Google Safe Browsing key (free): https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=
#   abuse.ch Auth-Key (free account, powers URLhaus): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# L3 (day 9+): report store
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side secret for HMAC pseudonymisation of scammer indicators (generate: openssl rand -hex 32)
DHAAL_HMAC_SECRET=
