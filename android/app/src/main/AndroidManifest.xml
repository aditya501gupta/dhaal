<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Load the citizen web app and call the DHAAL analysis API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibrate on a scam alert. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Post the high-priority scam-alert notification (runtime prompt on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- OPTIONAL, consent-gated: read incoming SMS so DHAAL can scan them.
         The app works fully without this; SMS scanning simply stays off. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- OPTIONAL, consent-gated: auto-text the family guardian when a scam is
         detected, so a son/daughter is warned automatically. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- OPTIONAL, consent-gated: know when a call starts so DHAAL can offer to listen. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- OPTIONAL, consent-gated: listen to a call (on speaker) via the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DHAAL">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires only after the user grants SMS permission AND enables the toggle. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Detects a call starting; only acts when the user enabled call guard. -->
        <receiver
            android:name=".CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Native "listen to the call" screen, opened from the call prompt. -->
        <activity
            android:name=".CallGuardActivity"
            android:exported="false"
            android:theme="@style/Theme.DHAAL" />
    </application>
</manifest>
